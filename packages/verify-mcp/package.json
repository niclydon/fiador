{
  "author": "Nic Lydon",
  "bin": {
    "verify-mcp": "./dist/main.js"
  },
  "dependencies": {
    "@fiador/verify": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^4.6.7"
  },
  "description": "MCP server over @fiador/verify: read-only tools that answer whether a unique human stands behind an agent wallet. No semantics of its own; every result is the core's public projection.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "server.json"
  ],
  "license": "Apache-2.0",
  "name": "@fiador/verify-mcp",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/main.js",
    "start:http": "node dist/main.js --http",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.2.0",
  "mcpName": "io.github.niclydon/verify-mcp",
  "publishConfig": {
    "access": "public"
  }
}
